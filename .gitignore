# ── 환경변수 / 시크릿 ──
.env
.env.*
!.env.example
*.pem
*.key

# ── 크롤링 CSV 원본 (저장소에 올리지 않고 팀 비공개 공유 위치로 전달한다) ──
# 테스트용 CSV는 테스트가 실행될 때 만들기 때문에 저장소에 CSV를 두지 않는다. 이미 추적 중인 파일에는 영향이 없다.
*.csv

# ── Gradle / Java ──
.gradle/
build/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
hs_err_pid*

# ── IDE ──
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
out/

# ── Flutter / Dart (frontend/ 안의 .gitignore와 함께 적용) ──
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# ── Python (ai/) ──
__pycache__/
*.pyc
.venv/
venv/

# ── 로그 / OS / 임시 파일 ──
*.log
logs/
.DS_Store
Thumbs.db
*.swp
*.tmp

# ── Docker 로컬 데이터 ──
docker-data/
