# 이 파일을 복사해서 .env를 만들어 사용한다. (.env는 커밋하지 않는다)
#   cp .env.example .env
# docker compose는 루트의 .env를 자동으로 읽는다.

# ── MySQL ──
MYSQL_DATABASE=richreach
MYSQL_USER=richreach
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# 호스트에서 접속할 MySQL 포트
# (로컬에 MySQL이 이미 설치되어 3306이 사용 중일 수 있어 기본값을 3307로 둔다)
DB_PORT=3307

# ── Backend ──
BACKEND_PORT=8080

# CORS 허용 origin (쉼표로 구분). 비워두면 CORS를 열지 않는다.
# 예: http://localhost:3000,http://localhost:8081
CORS_ALLOWED_ORIGINS=

# ── 암호화 ──
# CODEF connected_id 등 민감정보를 AES-256으로 암호화할 때 쓰는 키.
# 아래 명령으로 생성해서 넣는다 (팀원마다 값이 달라도 되지만, 운영 환경은 별도 관리 필요):
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# ── 로그인 토큰(JWT) ──
# 토큰 서명 키 (32바이트 이상). 비워 두면 앱을 켤 때마다 임시 키를 만들어서 서버를 다시 켜면 로그인이 풀린다.
# 운영 환경에서는 반드시 설정한다. 아래 명령으로 생성한다:
#   openssl rand -base64 48
JWT_SECRET=

# ── 카드 혜택 CSV 스테이징 적재 (평소에는 비워 둔다) ──
# CSV를 DB에 넣을 때만 켠다. docker compose가 아니라 IDE/gradlew로 앱을 실행할 때 환경변수로 넘겨야 한다.
#   STAGING_LOAD_ON_STARTUP=true
#   STAGING_CSV_DIR=C:\경로\319종_카드혜택_전체자료   (CSV 8종과 선택적으로 mvp_cards.csv가 있는 폴더)
# 다 넣었으면 STAGING_LOAD_ON_STARTUP을 다시 끈다.
STAGING_LOAD_ON_STARTUP=false
STAGING_CSV_DIR=

# ── 시연용 샘플 데이터 (평소에는 꺼 둔다) ──
# 카드사 연동 없이 보유카드와 최근 7개월 거래를 만든다. 로컬 DB(localhost, 127.0.0.1, mysql)에서만 동작하고
# 공용 DB에서는 앱 시작을 중단한다. 먼저 회원가입을 한 계정의 이메일을 넣는다. 실제 카드사 연결이 있는 계정은 거부한다.
# MVP 카드가 승격되어 있어야(위 스테이징 적재) 분석할 수 있는 카드로 만들어진다.
#   DEMO_SEED_ON_STARTUP=true
#   DEMO_SEED_USER_EMAIL=내가 가입한 이메일
#   DEMO_SEED_RESET=true   (이 계정의 시연 데이터를 지우고 다시 만들 때)
# 다 만들었으면 DEMO_SEED_ON_STARTUP을 다시 끈다. (켜 둬도 같은 데이터가 나오지만 매번 시간이 든다.)
DEMO_SEED_ON_STARTUP=false
DEMO_SEED_USER_EMAIL=
DEMO_SEED_RESET=false

# ── CODEF ──
# codef.io 에서 데모/정식 서비스 승인 후 발급받은 값을 .env에만 넣는다. (절대 커밋하지 않는다)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
# 카드사 비밀번호 암호화용 RSA 공개키 (codef.io 계정 관리 > 키 관리에서 확인)
CODEF_PUBLIC_KEY=
# CODEF 응답의 구조(필드 경로와 타입)를 로그에 남긴다. 응답 구조를 확인할 때만 true로 켠다. 값은 남기지 않는다.
# (결과 코드만 값을 남긴다. 공용·운영 환경에서는 켜지 않는다.)
#   CODEF_DEBUG_LOGSHAPE=true

# ── 혜택 계산기 ──
# BENEFIT_RULE_SELECTION: READY_ONLY(기본, 사람이 원문과 대조해 확인한 규칙만) 또는 ALL(확인 전 규칙까지, 개발·시연용 참고값).
# BENEFIT_ENGINE: 쓸 계산기 이름. 기본 simple(임시 계산기). 다른 계산기를 꽂으면 그 이름으로 바꾼다.
BENEFIT_ENGINE=simple
BENEFIT_RULE_SELECTION=READY_ONLY
