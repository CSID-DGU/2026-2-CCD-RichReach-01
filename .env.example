# 이 파일을 복사해서 .env를 만들어 사용한다. (.env는 커밋하지 않는다)
#   cp .env.example .env
# docker compose는 루트의 .env를 자동으로 읽는다.

# ── MySQL ──
MYSQL_DATABASE=richreach
MYSQL_USER=richreach
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# 호스트에서 접속할 MySQL 포트
# (로컬에 MySQL이 이미 설치되어 3306이 사용 중일 수 있어 기본값을 3307로 둔다)
DB_PORT=3307

# ── Backend ──
BACKEND_PORT=8080

# CORS 허용 origin (쉼표로 구분). 비워두면 CORS를 열지 않는다.
# 예: http://localhost:3000,http://localhost:8081
CORS_ALLOWED_ORIGINS=

# ── 암호화 ──
# CODEF connected_id 등 민감정보를 AES-256으로 암호화할 때 쓰는 키.
# 아래 명령으로 생성해서 넣는다 (팀원마다 값이 달라도 되지만, 운영 환경은 별도 관리 필요):
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# ── 로그인 토큰(JWT) ──
# 토큰 서명 키 (32바이트 이상). 비워 두면 앱을 켤 때마다 임시 키를 만들어서 서버를 다시 켜면 로그인이 풀린다.
# 운영 환경에서는 반드시 설정한다. 아래 명령으로 생성한다:
#   openssl rand -base64 48
JWT_SECRET=

# ── 카드 혜택 CSV 스테이징 적재 (평소에는 비워 둔다) ──
# CSV를 DB에 넣을 때만 켠다. docker compose가 아니라 IDE/gradlew로 앱을 실행할 때 환경변수로 넘겨야 한다.
#   STAGING_LOAD_ON_STARTUP=true
#   STAGING_CSV_DIR=C:\경로\319종_카드혜택_전체자료   (CSV 8종과 선택적으로 mvp_cards.csv가 있는 폴더)
# 다 넣었으면 STAGING_LOAD_ON_STARTUP을 다시 끈다.
STAGING_LOAD_ON_STARTUP=false
STAGING_CSV_DIR=
