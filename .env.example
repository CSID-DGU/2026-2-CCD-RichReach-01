# 이 파일을 복사해서 .env를 만들어 사용한다. (.env는 커밋하지 않는다)
#   cp .env.example .env
# docker compose는 루트의 .env를 자동으로 읽는다.

# ── MySQL ──
MYSQL_DATABASE=richreach
MYSQL_USER=richreach
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# 호스트에서 접속할 MySQL 포트
# (로컬에 MySQL이 이미 설치되어 3306이 사용 중일 수 있어 기본값을 3307로 둔다)
DB_PORT=3307

# ── Backend ──
BACKEND_PORT=8080

# CORS 허용 origin (쉼표로 구분). 비워두면 CORS를 열지 않는다.
# 예: http://localhost:3000,http://localhost:8081
CORS_ALLOWED_ORIGINS=

# ── 암호화 ──
# CODEF connected_id 등 민감정보를 AES-256으로 암호화할 때 쓰는 키.
# 아래 명령으로 생성해서 넣는다 (팀원마다 값이 달라도 되지만, 운영 환경은 별도 관리 필요):
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=
